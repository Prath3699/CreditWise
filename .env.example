# Frontend configuration (Vite).
# Copy to .env and adjust as needed. Never commit .env.

# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:5000

# Optional: absolute API base URL for a deployed frontend.
# Leave unset to use the relative /api path (recommended when same-origin or proxied).
# Must match an allowed origin on the backend (CORS_ORIGINS).
# VITE_API_URL=https://api.example.com/api
