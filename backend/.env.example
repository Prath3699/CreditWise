# Backend configuration.
# Copy to backend/.env and adjust. Never commit .env.

NODE_ENV=development
PORT=5000

# Development fallback: local MongoDB, then an in-memory database.
# Production requires this to be set.
MONGO_URI=mongodb://127.0.0.1:27017/credwise

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of frontend origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# Optional: lax (default in development) or none (required for cross-site cookies
# on HTTPS deployments where the frontend and API use different sites).
# COOKIE_SAMESITE=lax
